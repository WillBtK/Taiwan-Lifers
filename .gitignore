# data/raw holds the pipeline's provenance archive: each source's payload
# exactly as published, one file per revision (scripts/fetch_sources.py).
# These are small and they are the only copy of sources we cannot re-fetch
# on demand, so they are tracked. Bulk scraped material belongs in cache/.
data/raw/**/*.pdf
data/raw/**/*.xlsx
data/raw/**/*.zip
.DS_Store
cache/
out/
